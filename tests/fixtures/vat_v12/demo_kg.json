    {
      "clause_id": "DEMO-C02",
      "policy_id": "DEMO-P01",
      "label": "第二条",
      "text": "虚构例外：如果测试对象存在经核对的特殊调整事项，则应解释差额，不得仅凭差额作出结论。",
      "effective_from": "2024-01-01",
      "effective_to": null
    },
