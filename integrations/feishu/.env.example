# 仅用于飞书企业自建应用的私聊联通测试。复制为同目录 .env；禁止提交真实凭据。
TAXPEARLS_FEISHU_APP_ID=
TAXPEARLS_FEISHU_APP_SECRET=
# 可选：限制收到事件中的 tenant_key；未填仍仅使用本自建应用的鉴权长连接。
TAXPEARLS_FEISHU_TENANT_KEY=
# 可选：仅允许这些测试者的 open_id，逗号分隔；不填则可用范围内用户可测试。
TAXPEARLS_FEISHU_ALLOWED_OPEN_IDS=

# 后端绑定桥接，默认关闭（保留原联通探针）。与网站侧配置一致后启用。
TAXPEARLS_FEISHU_BINDING_ENABLED=0
# 内部后端地址：HTTPS 源站或本机回环 HTTP；不是手机访问地址。
TAXPEARLS_FEISHU_BRIDGE_URL=http://127.0.0.1:8000
TAXPEARLS_FEISHU_BRIDGE_KEY=
