      "clause_id": "DEMO-C03",
      "policy_id": "DEMO-P01",
      "label": "第三条",
      "text": "虚构旧版本：测试情形应检查基础条件A。",
      "effective_from": "2024-01-01",
      "effective_to": "2026-06-30"
    },
